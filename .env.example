# Local server and storage
APP_HOST=127.0.0.1
APP_PORT=8000
APP_STORAGE_DIR=storage
DEMO_MODE=true
OCR_ENABLED=true
MAX_UPLOAD_BYTES=26214400
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional browser/API protection. Leave empty for local testing.
API_KEY=

# Live Tavily research. Leave the key empty to use the explicit offline fallback.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# OpenRouter or another OpenAI-compatible content provider.
LLM_PROVIDER=openai_compatible
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Enterprise retrieval. For the supplied Pinecone integrated-embedding index,
# check its Configuration panel and use the field-map target as PINECONE_TEXT_FIELD.
ENTERPRISE_KB_DIR=samples/input
PINECONE_MODE=integrated
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=__default__
PINECONE_API_VERSION=2026-04
PINECONE_TEXT_FIELD=text
